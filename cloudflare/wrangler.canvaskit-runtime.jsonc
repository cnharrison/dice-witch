{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-witch-canvaskit-runtime-local",
  "main": "packages/dice-canvaskit/tests/worker.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ]
}
