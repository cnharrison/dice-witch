{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-witch-data",
  "main": "workers/data/src/index.ts",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "crypto": "./packages/roll-domain/src/worker-crypto.ts"
  },
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "DISCORD_REST",
      "service": "dice-witch-discord-rest",
      "entrypoint": "DiscordRestService"
    }
  ],
  "d1_databases": [
    {
      "binding": "DATA",
      "database_name": "REPLACE_WITH_D1_DATABASE_NAME",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/data"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
