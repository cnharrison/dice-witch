{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-witch-roll",
  "main": "workers/roll/src/index.ts",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "alias": {
    "crypto": "./packages/roll-domain/src/worker-crypto.ts"
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "services": [
    {
      "binding": "DATA_SERVICE",
      "service": "dice-witch-data"
    },
    {
      "binding": "DISCORD_REST",
      "service": "dice-witch-discord-rest",
      "entrypoint": "DiscordRestService"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROLL_WORK",
        "class_name": "RollWork"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RollWork"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
