{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-witch-interactions-staging",
  "main": "workers/interactions/src/index.ts",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "alias": {
    "crypto": "./packages/roll-domain/src/worker-crypto.ts"
  },
  "vars": {
    "DISCORD_APPLICATION_ID": "100000000000000001",
    "DISCORD_TEST_GUILD_ID": "100000000000000002",
    "INVITE_LINK": "https://example.com/replace-with-staging-discord-invite",
    "SUPPORT_SERVER_LINK": "https://example.com/replace-with-support-link",
    "WEB_APP_URL": "https://REPLACE_WITH_STAGING_HOSTNAME/app",
    "ROLL_LIFECYCLE_TELEMETRY_VERSION": "2"
  },
  "services": [
    {
      "binding": "DATA_SERVICE",
      "service": "dice-witch-data-staging"
    },
    {
      "binding": "GATEWAY_STATUS",
      "service": "dice-witch-gateway-staging",
      "entrypoint": "GatewayStatusService"
    },
    {
      "binding": "DISCORD_REST",
      "service": "dice-witch-discord-rest-staging",
      "entrypoint": "DiscordRestService"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "DISCORD_PUBLIC_KEY",
      "store_id": "REPLACE_WITH_STAGING_SECRETS_STORE_ID",
      "secret_name": "DICE_WITCH_STAGING_DISCORD_PUBLIC_KEY"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROLL_WORK",
        "class_name": "RollWork",
        "script_name": "dice-witch-roll-staging"
      },
      {
        "name": "WEB_DELIVERY_WORK",
        "class_name": "WebDeliveryWork",
        "script_name": "dice-witch-roll-staging"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
