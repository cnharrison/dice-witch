{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-witch-roll-staging",
  "main": "workers/roll/src/index.ts",
  "compatibility_date": "2026-07-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ROLL_RENDER_VERSION": "4",
    "ROLL_VIEW_POLICY": "r41"
  },
  "alias": {
    "crypto": "./packages/roll-domain/src/worker-crypto.ts"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "services": [
    {
      "binding": "DATA_SERVICE",
      "service": "dice-witch-data-staging"
    },
    {
      "binding": "DISCORD_REST",
      "service": "dice-witch-discord-rest-staging",
      "entrypoint": "DiscordRestService"
    },
    {
      "binding": "DISCORD_MESSAGE_PROBE",
      "service": "dice-witch-discord-rest-staging",
      "entrypoint": "DiscordMessageProbeService"
    },
    {
      "binding": "GATEWAY_STATUS",
      "service": "dice-witch-gateway-staging",
      "entrypoint": "GatewayStatusService"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROLL_WORK",
        "class_name": "RollWork"
      },
      {
        "name": "LOG_WORK",
        "class_name": "LogWork"
      },
      {
        "name": "WEB_DELIVERY_WORK",
        "class_name": "WebDeliveryWork"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RollWork"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LogWork"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["WebDeliveryWork"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
