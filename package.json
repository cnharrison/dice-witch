{
  "name": "dice-witch",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.x"
  },
  "workspaces": [
    "cloudflare",
    "frontend",
    "packages/*"
  ],
  "overrides": {
    "mathjs": "15.2.0",
    "sharp": "0.35.3"
  },
  "scripts": {
    "audit:ci": "node tools/audit-policy.mjs",
    "build": "npm run build --workspace=@dice-witch/frontend",
    "staging:check": "npm run staging:check --workspace=@dice-witch/cloudflare",
    "lint": "npm run lint --workspaces --if-present",
    "lint:ci": "npm run lint --workspace=@dice-witch/dice-v4-model -- --max-warnings=0 && npm run lint --workspace=@dice-witch/cloudflare -- --max-warnings=0 && npm run lint --workspace=@dice-witch/frontend -- --max-warnings=65",
    "test": "node --test tools/audit-policy.test.mjs && npm run test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present"
  }
}
